# ==============================================
# DATABASE CONFIGURATION (PostgreSQL - Sakila)
# ==============================================
# In Docker Compose, DB_HOST is 'postgres'. For local run, use 'localhost'
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sakila

# ==============================================
# BLOCKCHAIN CONFIGURATION (Ganache)
# ==============================================
# In Docker Compose, GANACHE_RPC_URL is 'http://ganache:8545'
# For local run with Docker Ganache mapped port, use 'http://127.0.0.1:8545' (or 7545)
GANACHE_RPC_URL=http://127.0.0.1:8545
GANACHE_CHAIN_ID=1337

# Ganache default account #0 private key (deterministic test mnemonic)
DEPLOYER_PRIVATE_KEY=0xa473ac71bac13c808d2550e6a08eb63c0cb560b5174c1d8b49911d9c51c9cf23

# Contract address (auto-populated by docker-entrypoint deployment if left empty)
PAYMENT_CONTRACT_ADDRESS=

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
APP_PORT=3000
APP_NAME=Sakila Blockchain Integration

# QR Payment settings
QR_EXPIRATION_MINUTES=30

# Sync settings
SYNC_INTERVAL_MS=30000
