# ==============================================
# DATABASE CONFIGURATION (PostgreSQL - Sakila)
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sakila

# ==============================================
# BLOCKCHAIN CONFIGURATION (Ganache)
# ==============================================
GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_CHAIN_ID=5777

# Ganache default account #0 private key (DO NOT use in production)
DEPLOYER_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d

# Contract address (populated after deployment)
PAYMENT_CONTRACT_ADDRESS=

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
APP_PORT=3000
APP_NAME=Sakila Blockchain Integration

# QR Payment settings
QR_EXPIRATION_MINUTES=15

# Sync settings
SYNC_INTERVAL_MS=30000
